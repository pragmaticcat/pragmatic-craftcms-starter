# Read about configuration, here:
# https://craftcms.com/docs/4.x/config/
CRAFT_APP_ID=CraftCMS--c906fd55-79d3-45c1-a795-fa492acd3d94
CRAFT_ENVIRONMENT=dev
CRAFT_SECURITY_KEY=gAOkOHtWTEohto9TJTOviHErVVdhRvBP

# Database connection settings (config/db.php no longer required)
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=db
CRAFT_DB_PORT=db
CRAFT_DB_DATABASE=db
CRAFT_DB_USER=db
CRAFT_DB_PASSWORD=db
CRAFT_DB_SCHEMA=public
CRAFT_DB_TABLE_PREFIX=

# General settings (see config/general.php)
ALLOW_UPDATES=true
ALLOW_ADMIN_CHANGES=true
BACKUP_ON_UPDATE=true
CP_TRIGGER=admin
DEV_MODE=true
ENABLE_TEMPLATE_CACHING=0
ENVIRONMENT=local
HARD_MODE=true
IMAGE_DRIVER=imagick
IS_SYSTEM_LIVE=true
TEST_TO_EMAIL_ADDRESS=
USE_EMAIL_AS_USERNAME=true
PWT_CP_MAINTENANCE_MODE=false

CRAFT_WEB_ROOT="/var/www/html/web"

PRIMARY_SITE_URL=https://pragmatic-craftcms-starter.ddev.site/
CATALA_SITE_URL=https://pragmatic-craftcms-starter.ddev.site/
ESPANOL_SITE_URL=https://pragmatic-craftcms-starter.ddev.site/es/
ENGLISH_SITE_URL=https://pragmatic-craftcms-starter.ddev.site/en/

# SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Plugins / Other
GOOGLE_ANALYTICS_ID=
POSTMARK_TOKEN=
VITE_USE_DEV_SERVER=true

PWT_EDITION_OVERRIDE=pro

# Production access used by `ddev boot` and `ddev backup-project`.
# MySQL credentials remain on the production server. With password-based SSH,
# the command asks for the SSH password interactively.
PRODUCTION_SSH_URL=user@production-host
PRODUCTION_PROJECT_PATH=/absolute/path/to/the/craft-project
# PRODUCTION_SSH_PORT=22
# PRODUCTION_SSH_IDENTITY_FILE=/absolute/path/to/private-key

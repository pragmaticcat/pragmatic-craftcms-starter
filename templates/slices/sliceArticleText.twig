{% import '/includes/macros/media.twig' as media %}
{% set images = slice.imatges.all() %}
{% set options = slice.opcionsBloc %}
{% set textOptions = slice.opcionsText %}
{% set alignment = options.alineament ?? 'esquerra' %}
{% set narrow = (textOptions.ampleText ?? 'sencer') == 'reduit' %}
{% set columns = textOptions.numeroColumnesText ?? '1' %}
<section id="{{ slice.slug }}" class="py-5{{ options.destacaBloc ?? false ? ' bg-light' }}">
    <div class="container">
        <div class="row g-4 {{ alignment == 'centre' ? 'justify-content-center text-center' : (alignment == 'dreta' ? 'justify-content-end text-end' : '') }}">
            <div class="{{ images|length ? 'col-lg-8' : (narrow ? 'col-lg-8' : 'col-12') }}">
                {% if slice.titol %}<h2 class="mb-4">{{ slice.titol|nl2br }}</h2>{% endif %}
                {% if slice.text %}<div class="{{ columns == '2' ? 'article-text-columns-2' : '' }}">{{ slice.text|raw }}</div>{% endif %}
                {% if slice.textDestacat %}<div class="lead mt-4">{{ slice.textDestacat|raw }}</div>{% endif %}
            </div>
            {% if images|length %}<div class="col-lg-4">{% for image in images %}<div class="mb-3">{{ media.figure(image, {cover: {transform: 'fit1000', sizes: '(min-width: 992px) 33vw, 100vw'}}) }}</div>{% endfor %}</div>{% endif %}
        </div>
    </div>
</section>

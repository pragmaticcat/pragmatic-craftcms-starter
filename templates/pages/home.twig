{% import "/includes/macros/img.twig" as img %}
{% import "/includes/macros/svg.twig" as svg %}
{% import "/includes/macros/heading.twig" as heading %}

{% set pageId = entry.slug %}

{% extends "/layouts/base" %}

{% block pageId %}{{ pageId }}{% endblock %}

{% block body %}

  {% set page = entry.pagina.one() %}
  {% set pageSlices = page ? page.slices.all() : [] %}
  {# Add handles here when a slice renders headingTag as its visible headline. #}
  {% set headlineSliceHandles = ['sliceHomeMasthead', 'sliceContacto'] %}
  {{ heading.fallbackH1(entry.title, pageSlices, headlineSliceHandles) }}
  {% for slice in pageSlices %}
    {% include "slices/" ~ slice.type with {
      slice: slice,
      posicio: loop.index0,
      headingTag: heading.tag(slice, pageSlices, headlineSliceHandles)|trim
    } %}
  {% endfor %}

{% endblock %}

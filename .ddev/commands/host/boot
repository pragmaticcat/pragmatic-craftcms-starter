#!/usr/bin/env bash

## Description: Start the project, optionally refresh the production DB, and launch it
## Usage: boot
## Example: "ddev boot"

set -euo pipefail

project_root="${DDEV_APPROOT:-$(pwd -P)}"
# shellcheck source=../.production-db.sh
source "$project_root/.ddev/commands/.production-db.sh"

ddev start

if [[ ! -t 0 ]]; then
    echo "No interactive terminal detected; keeping the current local database."
    exit 0
fi

printf '\nDo you want to replace the LOCAL database with the latest production database? [y/N] '
read -r answer

case "$answer" in
    y|Y|yes|YES|s|S|si|SI|sí|Sí)
        temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/${DDEV_SITENAME:-craft}-boot.XXXXXX")"
        local_backup="$temp_dir/local-before-production.sql.gz"
        production_backup="$temp_dir/production.sql.gz"

        cleanup() {
            rm -rf "$temp_dir"
        }
        trap cleanup EXIT

        echo "Creating a safety backup of the current local database..."
        ddev export-db --file="$local_backup"
        download_production_db "$production_backup"

        echo "Replacing the local database with the production database..."
        if ! ddev import-db --file="$production_backup"; then
            echo "Import failed; restoring the previous local database..." >&2
            ddev import-db --file="$local_backup"
            exit 1
        fi
        ;;
    *)
        echo "Keeping the current local database."
        ;;
esac

ddev launch
